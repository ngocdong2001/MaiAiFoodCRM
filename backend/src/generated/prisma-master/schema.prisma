// Master database schema - stores tenant registry and global users
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-master"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_MASTER")
}

model tenant {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(100)
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  logoUrl      String?  @db.VarChar(500)
  databaseName String   @unique @db.VarChar(100)
  tier         String   @default("basic") @db.VarChar(20)
  maxUsers     Int      @default(5)
  maxGuests    Int      @default(1000)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  users        user[]

  @@index([slug], map: "Tenant_slug_idx")
  @@index([isActive], map: "Tenant_isActive_idx")
}

model user {
  id           Int       @id @default(autoincrement())
  tenantId     Int
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  name         String    @db.VarChar(255)
  role         String    @default("staff") @db.VarChar(30)
  isActive     Boolean   @default(true)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?   @db.VarChar(500)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  tenant       tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email], map: "User_tenantId_email_key")
  @@index([tenantId], map: "User_tenantId_idx")
  @@index([email], map: "User_email_idx")
  @@index([isActive], map: "User_isActive_idx")
  @@index([role], map: "User_role_idx")
}

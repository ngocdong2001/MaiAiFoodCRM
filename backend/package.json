{
  "name": "maiai-backend",
  "version": "1.0.0",
  "description": "MAIAI Backend API Server (Node.js/Express)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/server.ts",
    "build": "tsc",
    "seed": "ts-node-dev --transpile-only --exit-child prisma/seed.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "author": "",
  "license": "ISC"
}

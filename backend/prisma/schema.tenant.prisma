// Tenant database schema - stores business data for a specific tenant
// Each tenant has their own database: maiai_crm_{tenantId}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-tenant"
}

datasource db {
  provider = "mysql"
}

model airecommendation {
  id               Int             @id @default(autoincrement())
  guestId          Int
  appointmentId    Int?            @unique(map: "AIRecommendation_appointmentId_key")
  campaignId       Int?
  serviceId        Int
  reason           String          @db.VarChar(50)
  confidence       Decimal?        @db.Decimal(5, 2)
  potentialRevenue Decimal?        @db.Decimal(10, 2)
  status           String          @default("suggested") @db.VarChar(20)
  presentedAt      DateTime?
  resolvedAt       DateTime?
  resolvedBy       String?         @db.VarChar(100)
  createdAt        DateTime        @default(now())
  appointment      appointment?    @relation(fields: [appointmentId], references: [id], map: "AIRecommendation_appointmentId_fkey")
  upsellcampaign   upsellcampaign? @relation(fields: [campaignId], references: [id], map: "AIRecommendation_campaignId_fkey")
  guest            guest           @relation(fields: [guestId], references: [id], map: "AIRecommendation_guestId_fkey")
  service          service         @relation(fields: [serviceId], references: [id], map: "AIRecommendation_serviceId_fkey")

  @@index([campaignId], map: "AIRecommendation_campaignId_idx")
  @@index([guestId], map: "AIRecommendation_guestId_idx")
  @@index([serviceId], map: "AIRecommendation_serviceId_fkey")
  @@index([status], map: "AIRecommendation_status_idx")
}

model appointment {
  id                 Int                  @id @default(autoincrement())
  guestId            Int
  staffId            Int
  startTime          DateTime
  endTime            DateTime
  status             String               @default("pending") @db.VarChar(20)
  priority           String               @default("normal") @db.VarChar(10)
  source             String?              @db.VarChar(20)
  notes              String?              @db.Text
  cancelReason       String?              @db.Text
  createdBy          String?              @db.VarChar(100)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  airecommendation   airecommendation?
  guest              guest                @relation(fields: [guestId], references: [id], map: "Appointment_guestId_fkey")
  staff              staff                @relation(fields: [staffId], references: [id], map: "Appointment_staffId_fkey")
  appointmentservice appointmentservice[]
  payment            payment?

  @@index([guestId], map: "Appointment_guestId_idx")
  @@index([staffId], map: "Appointment_staffId_idx")
  @@index([startTime], map: "Appointment_startTime_idx")
  @@index([status], map: "Appointment_status_idx")
}

model appointmentservice {
  id                Int         @id @default(autoincrement())
  appointmentId     Int
  serviceId         Int
  staffId           Int?
  priceAtBooking    Decimal     @db.Decimal(10, 2)
  durationAtBooking Int?
  notes             String?     @db.VarChar(500)
  status            String      @default("pending") @db.VarChar(20)
  appointment       appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, map: "AppointmentService_appointmentId_fkey")
  service           service     @relation(fields: [serviceId], references: [id], map: "AppointmentService_serviceId_fkey")
  staff             staff?      @relation(fields: [staffId], references: [id], map: "AppointmentService_staffId_fkey")

  @@unique([appointmentId, serviceId], map: "AppointmentService_appointmentId_serviceId_key")
  @@index([appointmentId], map: "AppointmentService_appointmentId_idx")
  @@index([serviceId], map: "AppointmentService_serviceId_idx")
  @@index([staffId], map: "AppointmentService_staffId_fkey")
}

model auditlog {
  id          Int      @id @default(autoincrement())
  entityType  String   @db.VarChar(50)
  entityId    Int
  action      String   @db.VarChar(20)
  oldValues   String?  @db.Text
  newValues   String?  @db.Text
  performedBy String   @db.VarChar(100)
  ipAddress   String?  @db.VarChar(45)
  createdAt   DateTime @default(now())

  @@index([createdAt], map: "AuditLog_createdAt_idx")
  @@index([entityType, entityId], map: "AuditLog_entityType_entityId_idx")
}

model guest {
  id               Int                @id @default(autoincrement())
  name             String
  phone            String?            @unique(map: "Guest_phone_key") @db.VarChar(20)
  email            String?            @unique(map: "Guest_email_key") @db.VarChar(255)
  avatarUrl        String?            @db.VarChar(500)
  gender           String?            @db.VarChar(10)
  dateOfBirth      DateTime?          @db.Date
  totalVisits      Int                @default(0)
  totalSpend       Decimal            @default(0.00) @db.Decimal(12, 2)
  loyaltyPoints    Int                @default(0)
  memberSince      DateTime           @default(now())
  isActive         Boolean            @default(true)
  notes            String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  airecommendation airecommendation[]
  appointment      appointment[]
  guestnote        guestnote[]
  guesttagmapping  guesttagmapping[]
  payment          payment[]
}

model guestnote {
  id        Int      @id @default(autoincrement())
  guestId   Int
  content   String   @db.Text
  author    String?  @db.VarChar(100)
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
  guest     guest    @relation(fields: [guestId], references: [id], onDelete: Cascade, map: "GuestNote_guestId_fkey")

  @@index([guestId], map: "GuestNote_guestId_idx")
}

model guesttag {
  id              Int               @id @default(autoincrement())
  name            String            @unique(map: "GuestTag_name_key") @db.VarChar(100)
  color           String?           @db.VarChar(20)
  icon            String?           @db.VarChar(50)
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  guesttagmapping guesttagmapping[]

  @@index([name], map: "GuestTag_name_idx")
}

model guesttagmapping {
  id        Int      @id @default(autoincrement())
  guestId   Int
  tagId     Int
  createdAt DateTime @default(now())
  guest     guest    @relation(fields: [guestId], references: [id], onDelete: Cascade, map: "GuestTagMapping_guestId_fkey")
  guesttag  guesttag @relation(fields: [tagId], references: [id], onDelete: Cascade, map: "GuestTagMapping_tagId_fkey")

  @@unique([guestId, tagId], map: "GuestTagMapping_guestId_tagId_key")
  @@index([guestId], map: "GuestTagMapping_guestId_idx")
  @@index([tagId], map: "GuestTagMapping_tagId_idx")
}

model payment {
  id             Int         @id @default(autoincrement())
  appointmentId  Int         @unique(map: "Payment_appointmentId_key")
  guestId        Int
  staffId        Int?
  amount         Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0.00) @db.Decimal(10, 2)
  tipAmount      Decimal     @default(0.00) @db.Decimal(10, 2)
  finalAmount    Decimal     @db.Decimal(12, 2)
  paymentMethod  String      @db.VarChar(20)
  paymentStatus  String      @default("paid") @db.VarChar(20)
  paidAt         DateTime    @default(now())
  receiptNumber  String?     @unique(map: "Payment_receiptNumber_key") @db.VarChar(50)
  notes          String?     @db.VarChar(500)
  createdAt      DateTime    @default(now())
  appointment    appointment @relation(fields: [appointmentId], references: [id], map: "Payment_appointmentId_fkey")
  guest          guest       @relation(fields: [guestId], references: [id], map: "Payment_guestId_fkey")
  staff          staff?      @relation(fields: [staffId], references: [id], map: "Payment_staffId_fkey")
  refund         refund[]
  paymentdetail  paymentdetail[]

  @@index([guestId], map: "Payment_guestId_idx")
  @@index([paidAt], map: "Payment_paidAt_idx")
  @@index([paymentMethod], map: "Payment_paymentMethod_idx")
  @@index([staffId], map: "Payment_staffId_fkey")
}

// One row per service within a Payment (Payment = one Booking checkout, PaymentDetail = one Service line item)
model paymentdetail {
  id        Int      @id @default(autoincrement())
  paymentId Int
  serviceId Int
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  payment   payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "PaymentDetail_paymentId_fkey")
  service   service  @relation(fields: [serviceId], references: [id], map: "PaymentDetail_serviceId_fkey")

  @@unique([paymentId, serviceId], map: "PaymentDetail_paymentId_serviceId_key")
  @@index([paymentId], map: "PaymentDetail_paymentId_idx")
  @@index([serviceId], map: "PaymentDetail_serviceId_idx")
}

model refund {
  id         Int      @id @default(autoincrement())
  paymentId  Int
  amount     Decimal  @db.Decimal(12, 2)
  reason     String   @db.Text
  status     String   @default("pending") @db.VarChar(20)
  approvedBy String?  @db.VarChar(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  payment    payment  @relation(fields: [paymentId], references: [id], map: "Refund_paymentId_fkey")

  @@index([paymentId], map: "Refund_paymentId_idx")
}

model service {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(255)
  description        String?              @db.Text
  price              Decimal              @db.Decimal(10, 2)
  durationMinutes    Int
  categoryId         Int
  imageUrl           String?              @db.VarChar(500)
  isActive           Boolean              @default(true)
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  airecommendation   airecommendation[]
  appointmentservice appointmentservice[]
  paymentdetail      paymentdetail[]
  servicecategory    servicecategory      @relation(fields: [categoryId], references: [id], map: "Service_categoryId_fkey")

  @@index([categoryId], map: "Service_categoryId_idx")
}

model servicecategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique(map: "ServiceCategory_name_key") @db.VarChar(100)
  description String?   @db.VarChar(500)
  icon        String?   @db.VarChar(50)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  service     service[]
}

model setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique(map: "Setting_key_key") @db.VarChar(100)
  value     String   @db.Text
  group     String   @db.VarChar(50)
  dataType  String   @default("string") @db.VarChar(10)
  label     String?  @db.VarChar(255)
  updatedAt DateTime

  @@index([group], map: "Setting_group_idx")
}

model staff {
  id                    Int                     @id @default(autoincrement())
  name                  String
  role                  String                  @db.VarChar(30)
  status                String                  @default("active") @db.VarChar(20)
  phone                 String?                 @db.VarChar(20)
  email                 String?                 @db.VarChar(255)
  avatarUrl             String?                 @db.VarChar(500)
  hourlyRate            Decimal?                @db.Decimal(8, 2)
  commissionRate        Decimal?                @db.Decimal(5, 2)
  joinDate              DateTime?               @db.Date
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  appointment           appointment[]
  appointmentservice    appointmentservice[]
  payment               payment[]
  staffschedule         staffschedule[]
  staffspecialtymapping staffspecialtymapping[]
}

model staffschedule {
  id         Int      @id @default(autoincrement())
  staffId    Int
  date       DateTime @db.Date
  startTime  String   @db.VarChar(5)
  endTime    String   @db.VarChar(5)
  breakStart String?  @db.VarChar(5)
  breakEnd   String?  @db.VarChar(5)
  isDayOff   Boolean  @default(false)
  note       String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  staff      staff    @relation(fields: [staffId], references: [id], onDelete: Cascade, map: "StaffSchedule_staffId_fkey")

  @@unique([staffId, date], map: "StaffSchedule_staffId_date_key")
  @@index([date], map: "StaffSchedule_date_idx")
}

model staffspecialty {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @unique(map: "StaffSpecialty_name_key") @db.VarChar(100)
  description           String?                 @db.VarChar(500)
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  staffspecialtymapping staffspecialtymapping[]

  @@index([name], map: "StaffSpecialty_name_idx")
}

model staffspecialtymapping {
  id             Int            @id @default(autoincrement())
  staffId        Int
  specialtyId    Int
  createdAt      DateTime       @default(now())
  staffspecialty staffspecialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade, map: "StaffSpecialtyMapping_specialtyId_fkey")
  staff          staff          @relation(fields: [staffId], references: [id], onDelete: Cascade, map: "StaffSpecialtyMapping_staffId_fkey")

  @@unique([staffId, specialtyId], map: "StaffSpecialtyMapping_staffId_specialtyId_key")
  @@index([specialtyId], map: "StaffSpecialtyMapping_specialtyId_idx")
  @@index([staffId], map: "StaffSpecialtyMapping_staffId_idx")
}

model upsellcampaign {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(255)
  description      String?            @db.Text
  type             String             @db.VarChar(30)
  startDate        DateTime?
  endDate          DateTime?
  targetTags       String?            @db.Text
  discountPct      Decimal?           @db.Decimal(5, 2)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  airecommendation airecommendation[]

  @@index([isActive, startDate, endDate], map: "UpsellCampaign_isActive_startDate_endDate_idx")
}
